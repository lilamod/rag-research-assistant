# --- LLM provider (chat generation) ---
# "gemini"    -> free, no card required - get a key at
#                https://aistudio.google.com/apikey. Recommended default,
#                also used for embeddings below (one key for everything).
# "anthropic" -> Claude, needs a funded Anthropic account (no free quota).
# "openai"    -> needs a funded OpenAI account (no free quota).
LLM_PROVIDER=gemini

# Gemini settings (used if LLM_PROVIDER=gemini and/or EMBEDDING_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Anthropic settings (only used if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI settings (only used if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings ---
# "gemini" -> free, no card required, same GEMINI_API_KEY as above.
#             Recommended default for low-memory hosts.
# "local"  -> sentence-transformers, runs on CPU, no API key needed, but
#             pulls in torch (~1GB+ RAM to even import). Fine for a laptop
#             or a real VM; too heavy for small/free-tier hosts.
# "voyage" -> uses Voyage AI's embeddings API (needs VOYAGE_API_KEY). Free
#             tier (200M tokens) exists but is rate-limited to 3 RPM until
#             you add a (non-charging) card.
# "openai" -> uses OpenAI's embeddings API (needs OPENAI_API_KEY). No free
#             quota - your OpenAI account needs billing set up.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-lite

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=5

# --- Storage ---
UPLOAD_DIR=data/uploads
INDEX_DIR=data/index

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Comma-separated list of allowed origins for the deployed frontend.
# Example: https://your-app.vercel.app,https://your-app-git-main-you.vercel.app
# Defaults to "*" (any origin) which is fine for local dev / quick demos.
CORS_ORIGINS=*
