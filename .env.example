# --- LLM provider ---
# Choose "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic settings (used if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI settings (used if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings ---
# "local"  -> sentence-transformers, runs on CPU, no API key needed, but
#             pulls in torch (~1GB+ RAM to even import). Fine for a laptop
#             or a real VM; too heavy for small/free-tier hosts.
# "voyage" -> lightweight, uses Voyage AI's embeddings API (needs
#             VOYAGE_API_KEY). Has a genuine free tier (200M tokens on
#             current models, no card required) - recommended default
#             for low-memory hosts like Render's free tier.
# "openai" -> lightweight, uses OpenAI's embeddings API instead (needs
#             OPENAI_API_KEY regardless of LLM_PROVIDER). No free API
#             quota - your OpenAI account needs billing set up.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_EMBEDDING_MODEL=voyage-4-lite

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=5

# --- Storage ---
UPLOAD_DIR=data/uploads
INDEX_DIR=data/index

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Comma-separated list of allowed origins for the deployed frontend.
# Example: https://your-app.vercel.app,https://your-app-git-main-you.vercel.app
# Defaults to "*" (any origin) which is fine for local dev / quick demos.
CORS_ORIGINS=*
